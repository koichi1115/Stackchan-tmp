RELAY_HOST=127.0.0.1
RELAY_PORT=8787
# 返答の生成元。webhook = Grok の routine（起動確認だけ返す非同期型で、会話の返答には向かない）
# grok_api = xAI API を直接呼ぶ（同期、grok-4.3 で 1 往復 0.05 円未満）。会話には grok_api を推奨。
REPLY_ENGINE=webhook
GROK_WEBHOOK_URL=https://example.invalid/grok-webhook
GROK_WEBHOOK_SENDER_KEY=replace-with-your-sender-key
# REPLY_ENGINE=grok_api のとき。鍵は console.x.ai で発行。system prompt は prompt.txt を読む。
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_API_URL=https://api.x.ai/v1/responses
SYSTEM_PROMPT_FILE=prompt.txt
GROK_TIMEOUT_SECONDS=5
MAX_REPLY_LENGTH=120

# 音声認識と音声合成はリレー側で行います。鍵が必要なエンジンを使う場合も、鍵はこの .env にだけ置きます。
# 既定は mock です。オフライン検証は mock のまま行えます。
STT_ENGINE=mock
STT_URL=
TTS_ENGINE=mock
TTS_URL=
TTS_SPEAKER_ID=1
# VOICEVOX の話速と音量の倍率（1.0 が既定の声）。話速は 1.1 前後が聞きやすい。
TTS_SPEED_SCALE=1.1
TTS_VOLUME_SCALE=1.0
SPEECH_TIMEOUT_SECONDS=20
# whisper に渡す初期プロンプト。未設定なら WAKE_WORDS の先頭の一語を使います。
# これが無いと whisper は「スタックちゃん」を「スタークちゃん」と書き起こし、ウェイクワードが通りません。
# 空にすると渡しません（STT_PROMPT= と書いた場合）。既定のままで良ければ触りません。
# STT_PROMPT=スタックちゃん
MAX_AUDIO_BYTES=1000000
MOCK_TRANSCRIPT=こんにちは

# 実機を使うときの例（いずれも家庭内で動かす鍵不要のエンジン）
# RELAY_HOST=192.168.1.20
# STT_ENGINE=whisper_http
# STT_URL=http://127.0.0.1:8080/inference
# TTS_ENGINE=voicevox_http
# TTS_URL=http://127.0.0.1:50021

# s4: ウェイクワードと受信箱（docs/always-on-mac.md）
WAKE_WORDS=スタックちゃん,すたっくちゃん,スタックチャン
WAKE_ACK_TEXT=はい？
WAKE_WINDOW_SECONDS=8
VAD_THRESHOLD=600
VAD_SILENCE_MS=700
VAD_MAX_SECONDS=12
# Grok からの読み上げ。空なら巡回しません。INBOX_POLL_KEY は巡回キー（送信キーではありません）。
INBOX_URL=
INBOX_POLL_KEY=
INBOX_POLL_SECONDS=5
INBOX_MESSAGE_TTL_SECONDS=21600
