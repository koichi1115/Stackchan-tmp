RELAY_HOST=127.0.0.1
RELAY_PORT=8787
GROK_WEBHOOK_URL=https://example.invalid/grok-webhook
GROK_WEBHOOK_SENDER_KEY=replace-with-your-sender-key
GROK_TIMEOUT_SECONDS=5
MAX_REPLY_LENGTH=120

# 音声認識と音声合成はリレー側で行います。鍵が必要なエンジンを使う場合も、鍵はこの .env にだけ置きます。
# 既定は mock です。オフライン検証は mock のまま行えます。
STT_ENGINE=mock
STT_URL=
TTS_ENGINE=mock
TTS_URL=
TTS_SPEAKER_ID=1
SPEECH_TIMEOUT_SECONDS=20
MAX_AUDIO_BYTES=1000000
MOCK_TRANSCRIPT=こんにちは

# 実機を使うときの例（いずれも家庭内で動かす鍵不要のエンジン）
# RELAY_HOST=192.168.1.20
# STT_ENGINE=whisper_http
# STT_URL=http://127.0.0.1:8080/inference
# TTS_ENGINE=voicevox_http
# TTS_URL=http://127.0.0.1:50021
